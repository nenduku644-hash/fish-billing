{
  "name": "aaryan-aqua-billing",
  "version": "5.3.0",
  "description": "Aaryan Aqua Needs - Professional GST Billing Application",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:mac-arm": "electron-builder --mac --arm64",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mqtt": "^5.15.2",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aaryanaqua.billing",
    "productName": "Aaryan Aqua Needs",
    "files": [
      "index.html",
      "index_v5.js",
      "invoice_utils_v5.js",
      "index.css",
      "lord_ganesha.jpg",
      "lord_hanuman.jpg",
      "rallis_logo.png",
      "signature.png",
      "manifest.json",
      "electron-main.js",
      "mqtt.min.js",
      "jsqr.min.js"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "lord_ganesha.jpg"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": ["dmg", "zip"],
      "icon": "lord_ganesha.jpg"
    }
  }
}
